$animation "a_neck_trans_fwd" "combine_wallhammer_anims/a_neck_trans_fwd.smd" {
	fps 30
}

$animation "a_neck_trans_back" "combine_wallhammer_anims/a_neck_trans_back.smd" {
	fps 30
}

$animation "a_head_rot_dwn" "combine_wallhammer_anims/a_head_rot_dwn.smd" {
	fps 30
}

$animation "a_head_rot_up" "combine_wallhammer_anims/a_head_rot_up.smd" {
	fps 30
}

$animation "a_head_rot_z_rt" "combine_wallhammer_anims/a_head_rot_z_rt.smd" {
	fps 30
}

$animation "a_head_rot_z_lt" "combine_wallhammer_anims/a_head_rot_z_lt.smd" {
	fps 30
}

$sequence "body_rot_z" {
	"a_body_rot_z_lt"
	"a_body_rot"
	"a_body_rot_z_rt"
	fps 30
	hidden
	autoplay
	delta
	blend "body_yaw" 28.71194 -28.71179
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "spine_rot_z" {
	"a_spine_rot_z_lt"
	"a_spine_rot"
	"a_spine_rot_z_rt"
	fps 30
	hidden
	autoplay
	delta
	blend "spine_yaw" 29.7798 -29.7798
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "neck_trans_x" {
	"a_neck_trans_back"
	"a_neck_trans"
	"a_neck_trans_fwd"
	fps 30
	hidden
	autoplay
	delta
	blend "neck_trans" -0.18034 0.232382
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "head_rot_z" {
	"a_head_rot_z_lt"
	"a_head_rot"
	"a_head_rot_z_rt"
	fps 30
	hidden
	autoplay
	delta
	blend "head_yaw" 43.301 -43.30119
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "head_rot_y" {
	"a_head_rot_dwn"
	"a_head_rot"
	"a_head_rot_up"
	fps 30
	hidden
	autoplay
	delta
	blend "head_pitch" 23.00001 -15.00002
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "head_rot_x" {
	"a_head_rot_lt"
	"a_head_rot"
	"a_head_rot_rt"
	fps 30
	hidden
	autoplay
	delta
	blend "head_roll" -15.51244 15.5124
	blendwidth 3
	fadein 0.2
	fadeout 0.2
}

$sequence "ragdoll" {
	"combine_wallhammer_anims/ragdoll.smd"
	fps 30
	activity "ACT_DIERAGDOLL" 1
	fadein 0.2
	fadeout 0.2
}

$collisionjoints "combine_wallhammer_physics.smd"
{
	$mass 65
	$inertia 1
	$damping 0
	$rotdamping 0
	$concave
	$maxconvexpieces 18
}

