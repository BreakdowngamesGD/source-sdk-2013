	"a_body_rot_z_lt"
	"a_body_rot"
	"a_body_rot_z_rt"
	fps 30
	hidden
	autoplay
	delta
	blend "body_yaw" 28.71194 -28.71179
	blendwidth 3
	fadein 0.2
	fadeout 0.2
	weightlist "weights_body_rot_z"
}

